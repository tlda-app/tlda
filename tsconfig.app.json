{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "fleet-dashboard/*": ["../fleet/dashboard/*"],
      "tldraw": ["../../.tldraw-fork/packages/tldraw/.tsbuild/index.d.ts"],
      "@tldraw/driver": ["../../.tldraw-fork/packages/driver/.tsbuild/index.d.ts"],
      "@tldraw/editor": ["../../.tldraw-fork/packages/editor/.tsbuild/index.d.ts"],
      "@tldraw/state": ["../../.tldraw-fork/packages/state/.tsbuild/index.d.ts"],
      "@tldraw/state-react": ["../../.tldraw-fork/packages/state-react/.tsbuild/index.d.ts"],
      "@tldraw/store": ["../../.tldraw-fork/packages/store/.tsbuild/index.d.ts"],
      "@tldraw/sync": ["../../.tldraw-fork/packages/sync/.tsbuild/index.d.ts"],
      "@tldraw/sync-core": ["../../.tldraw-fork/packages/sync-core/.tsbuild/index.d.ts"],
      "@tldraw/tlschema": ["../../.tldraw-fork/packages/tlschema/.tsbuild/index.d.ts"],
      "@tldraw/utils": ["../../.tldraw-fork/packages/utils/.tsbuild/index.d.ts"],
      "@tldraw/validate": ["../../.tldraw-fork/packages/validate/.tsbuild/index.d.ts"]
    },
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src"]
}
