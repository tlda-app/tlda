# Dockerfile.live — the LIVE tlda server (builds LaTeX), for the `tlda-live` Fly app.
# Differs from the published/snapshot image by adding a TeXLive layer so latexmk
# and dvisvgm actually run. Heavy TeXLive layer is first so it stays cached across
# frequent app-code redeploys.
FROM node:20-slim
WORKDIR /app

# --- TeXLive layer (heavy, ~2-3 GB, cached — changes rarely) ---
# Generous install for build reliability across the paper package tail seen in the
# scan (physics, mathtools, tikz, biblatex, algorithm2e, tcolorbox, subcaption,
# cleveref, fontspec/xetex, ...). Conference styles (icml/neurips) are project-local.
# NOTE: recommends are ON here (no --no-install-recommends). TeX collections list
# many real dependencies as *recommends* (lmodern, dvisvgm, font packages, …);
# stripping them caused build failures (dvisvgm-not-found, then lmodern.sty-not-found).
# Recommends-on pulls the companions real papers need. Bigger image, but image size
# doesn't affect runtime cost — build reliability does.
RUN apt-get update && apt-get install -y \
      texlive-latex-recommended texlive-latex-extra texlive-science \
      texlive-fonts-recommended texlive-fonts-extra texlive-bibtex-extra \
      texlive-pictures texlive-plain-generic texlive-xetex \
      lmodern dvisvgm biber latexmk ghostscript git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
# Fail the build early if any build-pipeline binary is missing or too old.
# NOTE: the SVG pipeline uses `dvisvgm --font-format=woff2` — verify this dvisvgm
# supports woff2 on first real build (Debian bookworm texlive should).
RUN latexmk --version && dvisvgm --version && biber --version && gs --version

# Build tools for native npm modules (better-sqlite3 compiles via node-gyp when no
# prebuilt binary is fetched). Separate layer so the TeXLive layer above stays cached.
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential python3 python3-venv \
    && rm -rf /var/lib/apt/lists/*

# spaCy + small English model power the outline highlighter (server/lib/outline/
# clause-split.py: clause-grain sentence splitting via `spawnSync('python3', ...)`).
# Without them /outline 500s with ModuleNotFoundError and the outline highlighter
# silently no-ops. Install into an isolated venv — Debian's system Python is
# PEP-668 externally-managed and --break-system-packages left spaCy with broken
# transitive deps (missing click). The venv is first on PATH so both node-gyp
# (npm install below) and the runtime `python3 clause-split.py` resolve to it.
ENV PATH="/opt/venv/bin:$PATH"
# Install spaCy + the en_core_web_sm model in one pip call, fetching the model
# WHEEL directly rather than via `spacy download` — the CLI path pulls typer/click
# and broke the build (typer installed without click). Direct wheel install needs
# no CLI; clause-split.py just does spacy.load("en_core_web_sm"). Model 3.8.x
# matches spaCy 3.8.x.
RUN python3 -m venv /opt/venv \
    && pip install --no-cache-dir "spacy>=3.8,<3.9" "click>=8.1" \
       "https://github.com/explosion/spacy-models/releases/download/en_core_web_sm-3.8.0/en_core_web_sm-3.8.0-py3-none-any.whl"

# --- Tailscale (official Debian repo) ---
# The Fly machine joins Skip's tailnet (see fly-entrypoint-live.sh, gated on
# TS_AUTHKEY) so the server is reachable privately over the tailnet rather than the
# open internet. Installs tailscaled (/usr/sbin) + tailscale (/usr/bin), both on
# the root PATH. Separate layer so it caches across app-code redeploys.
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && curl -fsSL https://pkgs.tailscale.com/stable/debian/bookworm.noarmor.gpg -o /usr/share/keyrings/tailscale-archive-keyring.gpg \
    && curl -fsSL https://pkgs.tailscale.com/stable/debian/bookworm.tailscale-keyring.list -o /etc/apt/sources.list.d/tailscale.list \
    && apt-get update && apt-get install -y --no-install-recommends tailscale \
    && rm -rf /var/lib/apt/lists/*

# --- runtime deps ---
# Install at /app (not server/) so BOTH server/*.mjs and shared/*.mjs resolve up to
# one /app/node_modules. shared/ imports @tldraw/* too, and from /app/shared it can't
# see /app/server/node_modules — installing at the root covers both trees.
COPY server/package.json ./package.json
COPY server/package-lock.json* ./
RUN npm install --production

# --- server code ---
COPY server/lib/ ./server/lib/
COPY server/routes/ ./server/routes/
COPY server/unified-server.mjs ./server/
COPY shared/ ./shared/
# Build pipeline shells out to /app/scripts/*.mjs (extract-synctex-lookup,
# compute-proof-pairing, patch-svg-images, …). Without these the synctex lookup
# never generates → highlights don't resolve to source lines.
COPY scripts/ ./scripts/

# Serve the tldraw SPA from this server too. For the PRIVATE tailnet deployment
# (server gated behind Tailscale, not the open internet), Skip's tldraw license
# allows self-hosting — so SPA + API + WS become ONE same-origin server, dropping
# the GitHub Pages split and the whole cross-origin URL/auth gymnastics. The server
# serves /app/dist (distDir = join(__dirname,'..','dist')) via express.static + an
# index.html catch-all. Built plain (no VITE_SYNC_SERVER) so the client is origin-
# relative. (Off the *.qtm285.github.io domain the tldraw watermark shows — accepted.)
COPY dist/ ./dist/

# --- entrypoint: wire mutable data (projects, fleet.db, yjs) to the volume ---
COPY scripts/fly-entrypoint-live.sh ./
RUN chmod +x fly-entrypoint-live.sh
WORKDIR /app/server
EXPOSE 5176
CMD ["/app/fly-entrypoint-live.sh"]
