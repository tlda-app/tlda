#!/bin/sh
# tlda pre-commit hook: run the suppression-pattern lint on staged changes.
#
# Mostly advisory — findings print to stderr. With --block, it BLOCKS the commit
# (exit 1) only when the staged diff ADDS an error-swallowing catch or bare
# `except: pass` (BLOCKING_PATTERNS). Net-new only: legacy hits stay advisory,
# and a reason comment inside the catch exempts a deliberate swallow. Genuine
# emergency bypass: `git commit --no-verify`.
#
# Install once with: bin/install-git-hooks.sh

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$REPO_ROOT" ]; then
  exit 0
fi

LINT="$REPO_ROOT/bin/tlda-lint-suppress.mjs"
if [ -x "$LINT" ] || [ -f "$LINT" ]; then
  node "$LINT" --block 1>/dev/null
  exit $?
fi

exit 0
