#!/bin/sh
# tlda post-merge hook: after work lands on main, find out whether main still
# compiles — and say so where the person who just landed will see it.
#
# WHY THIS EXISTS. On 2026-09-12 main did not build for two separate stretches
# hours apart: src/App.tsx imported a file that was never committed, and
# src/katexMacros.ts typed the KaTeX macro map as Record<string, string> while
# shared/katex-base-macros.mjs kept adding function macros. Both compile for
# their author, whose disk holds the missing half. Three lanes landed on top of
# a red main and none of them could have known.
#
# Nothing compiled main between a landing and a deploy. The deploy did, and it
# reported 26-35 minutes later by REFUSING SOMEBODY ELSE'S PUSH — so whoever
# learned about a break was never whoever caused it.
#
# There IS a CI workflow that compiles main (.github/workflows/deploy.yml, on
# push to main). It has never run: main is not pushed to GitHub, and local main
# is over 1200 commits ahead of origin/main. Existing-and-broken, not missing.
#
# It does not block. post-merge runs after the merge is already made, and that
# is deliberate — AGENTS.md is explicit that nothing here exists to stop people
# making decisions. The failure was never that someone landed bad code, it was
# that nobody found out for half an hour.

# Only main. A feature branch that does not compile is its author's business
# and is not yet anybody else's problem.
branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"
[ "$branch" = "main" ] || exit 0

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
[ -n "$REPO_ROOT" ] || exit 0

# No TypeScript means a fresh or partial checkout, not a landing to vet.
# Staying silent beats crying wolf about a tree that was never set up.
[ -d "$REPO_ROOT/node_modules/typescript" ] || exit 0

WORKER="$REPO_ROOT/bin/tlda-main-build-check.sh"
[ -f "$WORKER" ] || exit 0

# `git rev-parse --git-dir`, never "$REPO_ROOT/.git": in a WORKTREE .git is a
# FILE pointing at the real gitdir, so a path under it fails with "Not a
# directory". Nearly all work here happens in worktrees — the shared checkout is
# where someone else is standing — so the worktree case is the normal one. The
# deliberate-failure test is what surfaced this.
GIT_DIR_PATH="$(git rev-parse --git-dir 2>/dev/null)" || exit 0
case "$GIT_DIR_PATH" in
  /*) ;;
  *) GIT_DIR_PATH="$REPO_ROOT/$GIT_DIR_PATH" ;;
esac

SHA="$(git rev-parse --short HEAD 2>/dev/null)"

# `nohup`, so the check survives the shell that merged. A plain background
# subshell dies with its parent: measured the same day, one produced NO status
# file and NO stderr when its parent went away — a check that runs and reports
# nothing, which is precisely the failure this hook exists to remove. Ordinary
# background children are also reaped when an agent's turn ends.
#
# The work lives in a separate script invoked with ARGUMENTS rather than an
# inlined `sh -c '...'`. Inlining looked simpler and was wrong: the quoted body
# does not inherit the caller's shell variables, so every path arrived empty and
# the hook announced "main does not compile at " with no sha, no errors and no
# log — ON A TREE THAT COMPILED FINE. A checker that cries wolf gets muted, and
# then it protects nothing.
nohup sh "$WORKER" \
  "$REPO_ROOT" \
  "$GIT_DIR_PATH/tlda-main-build-status" \
  "${TMPDIR:-/tmp}/tlda-main-tsc-$SHA.log" \
  "$SHA" </dev/null >/dev/null 2>&1 &

exit 0
