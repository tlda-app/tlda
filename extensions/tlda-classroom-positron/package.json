{
  "name": "tlda-classroom",
  "displayName": "tlda Classroom",
  "description": "Preview, check, and hand in homework from Positron.",
  "version": "0.2.7",
  "publisher": "tlda-labs",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:quarto",
    "onUri"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "tldaClassroom.submit",
        "title": "Submit",
        "category": "Homework"
      },
      {
        "command": "tldaClassroom.zipForSubmission",
        "title": "Zip for submission",
        "category": "Homework"
      },
      {
        "command": "tldaClassroom.checkSubmission",
        "title": "Check this submission",
        "category": "Homework"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "tldaClassroom.submit",
          "when": "resourceExtname == .qmd",
          "group": "navigation@1"
        },
        {
          "command": "tldaClassroom.zipForSubmission",
          "when": "resourceExtname == .qmd",
          "group": "navigation@2"
        }
      ]
    }
  },
  "dependencies": {
    "fflate": "^0.8.3"
  }
}
