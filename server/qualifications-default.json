{
  "rules": [
    { "edit": "*.tex", "requires": ["editing-tex"] },
    { "edit": "*.bib", "requires": ["editing-tex"] },
    { "edit": "*.md",  "requires": ["editing-tex"], "condition": "latex-project" },

    { "tool": "playwright/*", "requires": ["app-testing"] },
    { "tool": "tlda/delegate", "requires": ["point-dont-paraphrase", "manager-team-stewardship"] },
    { "tool": "Agent", "requires": ["subagents"] },
    { "tool": "tlda/input_scratch", "requires": ["where-to-write"] },
    { "tool": "tlda/chat", "requires": ["explain-math-concretely"], "condition": "math-heavy" }
  ]
}
