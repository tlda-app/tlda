{
  "name": "tlda",
  "license": "MIT",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "bin": {
    "tlda": "./cli/tlda.mjs",
    "tlda-dev": "./cli/tlda-dev.mjs",
    "tlda-fly": "./bin/tlda-fly.mjs"
  },
  "scripts": {
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/darwin-arm64/spawn-helper 2>/dev/null || true",
    "prepare": "vite build && mkdir -p server/public && cp -r dist/* server/public/",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "deploy:live": "node scripts/live-deploy.mjs",
    "test:live-perf-upload": "node bin/live-perf-probe-upload-test.mjs",
    "lint": "node bin/lineage-name-derivation-guard.mjs && node bin/sync-on-event-loop-guard.mjs && node bin/await-fleet-store-guard.mjs && node bin/async-cascade-guard.mjs && node bin/connect-attempt-teardown-guard.mjs && eslint .",
    "preview": "vite preview",
    "start": "tlda server start && npm run dev",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.1",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.12",
    "@deepgram/sdk": "^5.4.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.220.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/sdk-metrics": "^2.9.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@replit/codemirror-vim": "^6.3.0",
    "@tanstack/react-virtual": "^3.13.23",
    "@tldraw/editor": "https://github.com/davidahirshberg/tldraw-fork/releases/download/tlda-v5.2.0-2/tldraw-editor-5.2.0-tlda.2.tgz",
    "@tldraw/mermaid": "5.2.0",
    "@tldraw/state": "5.2.0",
    "@tldraw/store": "5.2.0",
    "@tldraw/sync": "5.2.0",
    "@tldraw/sync-core": "5.2.0",
    "@tldraw/tlschema": "5.2.0",
    "@tldraw/utils": "5.2.0",
    "@tldraw/validate": "5.2.0",
    "tldraw": "5.2.0",
    "@xmldom/xmldom": "^0.8.11",
    "@xterm/addon-fit": "^0.11.0",
    "better-sqlite3": "^12.8.0",
    "blocked-at": "^1.2.0",
    "chokidar": "^5.0.0",
    "codemirror": "^6.0.2",
    "codemirror-lang-latex": "^0.2.0",
    "jsdom": "^27.0.1",
    "katex": "^0.16.28",
    "livekit-client": "^2.20.0",
    "livekit-server-sdk": "^2.15.5",
    "markdown-it": "^14.1.1",
    "markdown-it-anchor": "^9.2.0",
    "node-pty": "^1.1.0",
    "pino": "^10.3.1",
    "playwright": "^1.58.2",
    "proper-lockfile": "^4.1.2",
    "qrcode-terminal": "^0.12.0",
    "rbush": "^3.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-virtuoso": "^4.18.7",
    "stream-json": "^3.4.0",
    "tsx": "^4.22.4",
    "web-vitals": "^5.3.0",
    "xterm": "^5.3.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@eslint/js": "^9.39.1",
    "@playwright/cli": "^0.1.14",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "marked": "^18.0.5",
    "puppeteer-core": "^25.2.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
