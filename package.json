{
  "name": "tlda",
  "license": "MIT",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "tldraw-fork/packages/*"
  ],
  "bin": {
    "tlda": "./cli/tlda.mjs",
    "tlda-dev": "./cli/tlda-dev.mjs"
  },
  "scripts": {
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/darwin-arm64/spawn-helper 2>/dev/null || true",
    "prepare": "vite build && mkdir -p server/public && cp -r dist/* server/public/",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:tldraw-fork-runtime": "node scripts/build-tldraw-fork-runtime.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:fleet-gestures-ui": "node test/fleet-gestures-ui.mjs",
    "publish-snapshot": "node scripts/publish-snapshot.mjs",
    "start": "tlda server start && npm run dev",
    "smoke": "node scripts/smoke-test.mjs",
    "test": "node --test test/cli.test.mjs test/server.test.mjs",
    "test:all": "node --test test/cli.test.mjs test/server.test.mjs test/pipeline.test.mjs test/annotations.test.mjs",
    "test:e2e": "node --test test/pipeline.test.mjs test/annotations.test.mjs",
    "test:annotations": "node --test test/annotations.test.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.1",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.12",
    "@deepgram/sdk": "^5.4.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@replit/codemirror-vim": "^6.3.0",
    "@tanstack/react-virtual": "^3.13.23",
    "@tldraw/driver": "file:./tldraw-fork/packages/driver",
    "@tldraw/editor": "file:./tldraw-fork/packages/editor",
    "@tldraw/state": "file:./tldraw-fork/packages/state",
    "@tldraw/state-react": "file:./tldraw-fork/packages/state-react",
    "@tldraw/store": "file:./tldraw-fork/packages/store",
    "@tldraw/sync": "file:./tldraw-fork/packages/sync",
    "@tldraw/sync-core": "file:./tldraw-fork/packages/sync-core",
    "@tldraw/tlschema": "file:./tldraw-fork/packages/tlschema",
    "@tldraw/utils": "file:./tldraw-fork/packages/utils",
    "@tldraw/validate": "file:./tldraw-fork/packages/validate",
    "@xmldom/xmldom": "^0.8.11",
    "@xterm/addon-fit": "^0.11.0",
    "better-sqlite3": "^12.8.0",
    "blocked-at": "^1.2.0",
    "codemirror": "^6.0.2",
    "codemirror-lang-latex": "^0.2.0",
    "jsdom": "^27.0.1",
    "katex": "^0.16.28",
    "markdown-it": "^14.1.1",
    "markdown-it-anchor": "^9.2.0",
    "node-pty": "^1.1.0",
    "playwright": "^1.58.2",
    "qrcode-terminal": "^0.12.0",
    "rbush": "^3.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-virtuoso": "^4.18.7",
    "tldraw": "file:./tldraw-fork/packages/tldraw",
    "tsx": "^4.22.4",
    "xterm": "^5.3.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@eslint/js": "^9.39.1",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "puppeteer": "^24.36.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
